# Python virtual environment
.venv/
__pycache__/
*.pyc

# Compiled C++ extension (rebuild locally: cd cpp_extensions/lib && make clean && make)
*.so
*.o

# Analysis outputs: MCMC backends, mode-search results, cached simulated C coefficients
/output/

# Plots generated by the analysis. Anchored so that pre-existing figure directories
# elsewhere in the repo (e.g. NO2_properties_simulation/plots/) are still tracked.
/plots/
/NO2/plots/*
!/NO2/plots/analysis/

# Staged ADMs -- regenerate with: python scripts/stage_adms.py
/NO2_properties_simulation/axis_dist/bigr_layout/

# macOS
.DS_Store
